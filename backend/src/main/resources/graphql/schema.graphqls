type Query {
  accounts: [Account!]!
}

type Mutation {
  createAccount(input: CreateAccountInput!): Account!
}

type Account {
  id: ID!
  name: String!
  type: AccountType!
  currency: String!
  initialBalance: String!
  archived: Boolean!
  createdAt: String!
  updatedAt: String!
}

input CreateAccountInput {
  name: String!
  type: AccountType!
  currency: String!
  initialBalance: String!
}

enum AccountType {
  CURRENT
  SAVINGS
  CASH
  CREDIT_CARD
}
